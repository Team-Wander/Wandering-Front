{
  "env": {
    "browser": true,
    "es2021": true
  },
  "settings": {
    "import/resolver": {
      "typescript": {}
    },
    "react": {
      "version": "detect"
    }
  },
  "extends": ["prettier"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "prettier"],
  "rules": {
    "no-console": "warn",
    "no-duplicate-imports": "error",
    "indent": ["error", 2],
    "linebreak-style": 0,
    "import/prefer-default-export": "off",
    "react/prop-types": "off",
    "prettier/prettier": "error"
  }
}
